{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "signalcli": {
      "properties": {
        "envVars": {
          "additionalProperties": true,
          "description": "Upstream environment variables, named exactly as the image documents them. Declared here rather\nthan as values so every variable the image supports is validated without being set. The map\nstays open, so a variable added by a newer image release can be set without a chart release.\n\nBooleans and integers accept both the YAML and quoted forms, because the workload chart renders\n`value: {{ $value | quote }}` and the two are therefore identical by the time the container\nsees them.",
          "properties": {
            "AUTO_RECEIVE_SCHEDULE": {
              "description": "Cron expression calling the receive endpoint, for normal and native mode only. Do not set it while a consumer reads messages through the API: receive drains the queue from the Signal server, so whichever caller arrives second gets nothing.",
              "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$",
              "type": "string"
            },
            "DEFAULT_SIGNAL_TEXT_MODE": {
              "description": "Text mode used when a send payload omits text_mode.",
              "enum": [
                "normal",
                "styled"
              ],
              "required": []
            },
            "JSON_RPC_IGNORE_ATTACHMENTS": {
              "enum": [
                true,
                false,
                "true",
                "false"
              ],
              "required": []
            },
            "JSON_RPC_IGNORE_AVATARS": {
              "enum": [
                true,
                false,
                "true",
                "false"
              ],
              "required": []
            },
            "JSON_RPC_IGNORE_STICKERS": {
              "description": "Set true to stop sticker packs being downloaded. Sticker packs are the largest single consumer of volume space in a long-lived account.",
              "enum": [
                true,
                false,
                "true",
                "false"
              ],
              "required": []
            },
            "JSON_RPC_IGNORE_STORIES": {
              "enum": [
                true,
                false,
                "true",
                "false"
              ],
              "required": []
            },
            "JSON_RPC_TRUST_NEW_IDENTITIES": {
              "description": "How an unseen identity key is trusted in json-rpc mode.",
              "enum": [
                "on-first-use",
                "always",
                "never"
              ],
              "required": []
            },
            "LOG_LEVEL": {
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ],
              "required": []
            },
            "MODE": {
              "description": "signal-cli execution model. Also decides the receive contract: json-rpc and json-rpc-native make /v1/receive/{number} a WebSocket, the others leave it a GET. normal is slowest, native is medium, json-rpc is fastest but holds a JVM resident, json-rpc-native combines the last two.",
              "enum": [
                "normal",
                "native",
                "json-rpc",
                "json-rpc-native"
              ],
              "required": []
            },
            "PORT": {
              "description": "Port the API listens on. Changing it alone breaks the service and both probes, which address 8080 directly; change service.containerPort and the probe ports to match.",
              "oneOf": [
                {
                  "maximum": 65535,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                  "type": "string"
                }
              ],
              "required": []
            },
            "SIGNAL_CLI_CHOWN_ON_STARTUP": {
              "description": "Set false to skip the startup chown, which is slow on a volume holding many attachments or sticker packs.",
              "enum": [
                true,
                false,
                "true",
                "false"
              ],
              "required": []
            },
            "SIGNAL_CLI_CONFIG_DIR": {
              "description": "Account state directory inside the container. Changing it alone silently discards the registration, because the volume is still mounted at the old path; change volumeMounts to match.",
              "pattern": "^/",
              "type": "string"
            },
            "SIGNAL_CLI_GID": {
              "oneOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "type": "string"
                }
              ],
              "required": []
            },
            "SIGNAL_CLI_UID": {
              "oneOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "type": "string"
                }
              ],
              "required": []
            },
            "SWAGGER_HOST": {
              "minLength": 1,
              "type": "string"
            },
            "SWAGGER_IP": {
              "minLength": 1,
              "type": "string"
            },
            "SWAGGER_USE_HTTPS_AS_PREFERRED_SCHEME": {
              "enum": [
                true,
                false,
                "true",
                "false"
              ],
              "required": []
            }
          },
          "required": [],
          "title": "envVars"
        },
        "fullnameOverride": {
          "default": "signalcli",
          "description": "Without this the subchart names resources \u003crelease\u003e-\u003calias\u003e, e.g. signalcli-signalcli.",
          "title": "fullnameOverride",
          "type": "string"
        },
        "image": {
          "properties": {
            "pullPolicy": {
              "default": "IfNotPresent",
              "title": "pullPolicy",
              "type": "string"
            },
            "repository": {
              "default": "bbernhard/signal-cli-rest-api",
              "title": "repository",
              "type": "string"
            },
            "tag": {
              "default": "0.100",
              "description": "Pinned rather than left empty: the workload subchart falls back to *its own* appVersion, so\nan empty tag resolves to the workload chart version and pulls an image that does not exist.\nKeep this in step with the chart appVersion.",
              "title": "tag",
              "type": "string"
            }
          },
          "required": [],
          "title": "image",
          "type": "object"
        },
        "livenessProbe": {
          "default": false,
          "description": "No liveness probe by default. A JVM that is slow or busy is not a JVM that should be killed,\nand a restart drops the registered session and forces every consumer to reconnect.",
          "title": "livenessProbe",
          "type": "boolean"
        },
        "persistentVolumeClaims": {
          "items": {
            "anyOf": [
              {
                "properties": {
                  "accessModes": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        }
                      ],
                      "required": []
                    },
                    "title": "accessModes",
                    "type": "array"
                  },
                  "name": {
                    "default": "signalcli-pvc",
                    "title": "name",
                    "type": "string"
                  },
                  "storage": {
                    "default": "512Mi",
                    "title": "storage",
                    "type": "string"
                  }
                },
                "required": [],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "persistentVolumeClaims",
          "type": "array"
        },
        "readinessProbe": {
          "properties": {
            "failureThreshold": {
              "default": 3,
              "title": "failureThreshold",
              "type": "integer"
            },
            "httpGet": {
              "properties": {
                "path": {
                  "default": "/v1/about",
                  "title": "path",
                  "type": "string"
                },
                "port": {
                  "default": 8080,
                  "title": "port",
                  "type": "integer"
                }
              },
              "required": [],
              "title": "httpGet",
              "type": "object"
            },
            "periodSeconds": {
              "default": 20,
              "title": "periodSeconds",
              "type": "integer"
            }
          },
          "required": [],
          "title": "readinessProbe",
          "type": "object"
        },
        "replicaCount": {
          "default": "1",
          "description": "signal-cli registers one device against one account and keeps its state on one volume, so the\nwrapper cannot be scaled out.",
          "maximum": 1,
          "minimum": 0,
          "required": [],
          "title": "replicaCount"
        },
        "resources": {
          "description": "A JVM that is network-bound once warm but wants CPU headroom while it loads account state.\nKeep the reservation modest and raise only the ceiling so startup is not throttled.",
          "properties": {
            "limits": {
              "properties": {
                "cpu": {
                  "default": "2000m",
                  "title": "cpu",
                  "type": "string"
                },
                "memory": {
                  "default": "768Mi",
                  "title": "memory",
                  "type": "string"
                }
              },
              "required": [],
              "title": "limits",
              "type": "object"
            },
            "requests": {
              "properties": {
                "cpu": {
                  "default": "250m",
                  "title": "cpu",
                  "type": "string"
                },
                "memory": {
                  "default": "256Mi",
                  "title": "memory",
                  "type": "string"
                }
              },
              "required": [],
              "title": "requests",
              "type": "object"
            }
          },
          "required": [],
          "title": "resources",
          "type": "object"
        },
        "service": {
          "properties": {
            "containerPort": {
              "default": 8080,
              "title": "containerPort",
              "type": "integer"
            },
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "name": {
              "default": "http",
              "title": "name",
              "type": "string"
            },
            "port": {
              "default": 80,
              "title": "port",
              "type": "integer"
            },
            "protocol": {
              "default": "TCP",
              "title": "protocol",
              "type": "string"
            },
            "type": {
              "default": "ClusterIP",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "service",
          "type": "object"
        },
        "startupProbe": {
          "description": "The image exposes no /healthz endpoints, but /v1/about answers once the JVM has loaded account\nstate, which is the moment it can actually serve traffic.",
          "properties": {
            "failureThreshold": {
              "default": 30,
              "title": "failureThreshold",
              "type": "integer"
            },
            "httpGet": {
              "properties": {
                "path": {
                  "default": "/v1/about",
                  "title": "path",
                  "type": "string"
                },
                "port": {
                  "default": 8080,
                  "title": "port",
                  "type": "integer"
                }
              },
              "required": [],
              "title": "httpGet",
              "type": "object"
            },
            "initialDelaySeconds": {
              "default": 15,
              "title": "initialDelaySeconds",
              "type": "integer"
            },
            "periodSeconds": {
              "default": 10,
              "title": "periodSeconds",
              "type": "integer"
            }
          },
          "required": [],
          "title": "startupProbe",
          "type": "object"
        },
        "volumeMounts": {
          "items": {
            "anyOf": [
              {
                "properties": {
                  "mountPath": {
                    "default": "/home/.local/share/signal-cli",
                    "title": "mountPath",
                    "type": "string"
                  },
                  "name": {
                    "default": "data",
                    "title": "name",
                    "type": "string"
                  }
                },
                "required": [],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "volumeMounts",
          "type": "array"
        },
        "volumes": {
          "description": "Account state lives here. Without a volume the account must be re-registered after every\nrestart, which is the single most common way to get this deployment wrong.",
          "items": {
            "anyOf": [
              {
                "properties": {
                  "name": {
                    "default": "data",
                    "title": "name",
                    "type": "string"
                  },
                  "persistentVolumeClaim": {
                    "properties": {
                      "claimName": {
                        "default": "signalcli-pvc",
                        "title": "claimName",
                        "type": "string"
                      }
                    },
                    "required": [],
                    "title": "persistentVolumeClaim",
                    "type": "object"
                  }
                },
                "required": [],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "volumes",
          "type": "array"
        }
      },
      "required": [],
      "title": "signalcli",
      "type": "object"
    }
  },
  "required": [],
  "type": "object"
}
